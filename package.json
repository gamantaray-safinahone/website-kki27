{
  "name": "web-kki27",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run build",
    "db:push": "supabase db push --remote",
    "db:status": "supabase migration list --remote",
    "db:types": "supabase gen types --lang typescript --remote --schema public > src/types/database.types.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "1.9.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
